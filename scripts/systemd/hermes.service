[Unit]
Description=Hermes devenv stack (engine, dashboard, rustfs, caddy, nautilus)
Documentation=file:///home/rch/local/src/oss/hermes-agent/README.engine.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/local/src/oss/hermes-agent
Environment=HOME=%h
Environment=PATH=%h/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/bin:/bin
Environment=SIGNALS_PLUGINS=%h/local/src/wxs/signals-plugins
ExecStart=%h/.nix-profile/bin/devenv up -d
ExecStop=%h/.nix-profile/bin/devenv processes down

[Install]
WantedBy=default.target
