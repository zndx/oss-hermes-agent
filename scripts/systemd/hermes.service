# DEPRECATED as a membership hook. signals.target is a *system* group;
# this user unit never joins it (WantedBy=default.target is a different
# systemd instance). Use:
#   just install-systemd --peers hermes --enable
#   sudo systemctl start hermes.service
# Kept so an old user symlink does not silently start a second graph.
[Unit]
Description=DEPRECATED — Hermes membership is system hermes.service (signals.target)
Documentation=file:///home/rch/local/src/oss/hermes-agent/README.engine.md

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/echo "hermes.service is a signals.target system unit; this user unit is a no-op"

[Install]
WantedBy=default.target
